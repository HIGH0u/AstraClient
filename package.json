{
  "name": "astra-client",
  "version": "0.7.0",
  "private": true,
  "description": "A quiet place to begin. Astra Minecraft Java client.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check electron/main.cjs && node --check electron/auth.cjs && node --check src/app.js",
    "package": "npm run build:ui && npm run notices && node scripts/package.cjs",
    "build:ui": "esbuild src/hub-entry.js --bundle --minify --outfile=src/hub.bundle.js",
    "notices": "node scripts/notices.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.58.0",
    "electron": "44.7.0",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "msmc": "^5.0.5",
    "skinview3d": "^3.4.2"
  },
  "productName": "Astra",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/HIGH0u/AstraClient.git"
  },
  "homepage": "https://github.com/HIGH0u/AstraClient"
}
